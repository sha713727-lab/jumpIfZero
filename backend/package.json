{
  "name": "@jumpifzero/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file=.env --experimental-strip-types src/server.ts",
    "dev": "node --env-file=.env --experimental-strip-types --watch src/server.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "test:integration": "node --env-file=.env --experimental-strip-types --test tests/integration/**/*.test.ts tests/journeys/**/*.test.ts",
    "test": "npm run test:unit && npm run test:integration",
    "cleanup:expired": "node --env-file=.env scripts/cleanup-expired.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@jumpifzero/contracts": "*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.69.0",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "pg": "8.23.0",
    "redis": "^6.2.1",
    "swagger-ui-dist": "^5.32.14"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
